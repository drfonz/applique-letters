{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@indigolabsltd/applique-core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["src", "packages/core/src/opentype.d.ts", "vite.config.ts"]
}
